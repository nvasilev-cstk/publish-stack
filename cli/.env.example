# Stack credentials
CS_STACK_API_KEY=your_stack_api_key
CS_MANAGEMENT_TOKEN=your_management_token

# Which environment to publish to. Kept as a setting (not hardcoded) so it
# can be swapped later without touching code.
CS_ENVIRONMENT=production

# Region the stack lives in: NA | EU | AU | AZURE_NA | AZURE_EU | GCP_NA | GCP_EU
# Determines the CMA host. Override with CS_HOST directly if you need a
# host not covered by CS_REGION.
CS_REGION=EU

# CMA org-wide limit is 10 requests/sec. Kept a bit under that as a safety
# margin for clock drift / other processes hitting the same org.
CS_RATE_LIMIT_RPS=8

# Optional: the script auto-detects the master locale (the one locale with
# no fallback_locale). Set this to override that detection if it's ambiguous.
# CS_MASTER_LOCALE=en-us
